        <size>
         <width>40</width>
         <height>14</height>
        </size>
       </property>
      </spacer>
     </item>
     <item>
      <!-- DB connection status: a small colored-dot indicator in the
           corner, not a group box with buttons. The DB auto-connects
           when this tab first opens (ReportingModule._create_widget), so
           there's no manual Connect/Disconnect step to give controls for.
           Clickable to retry if the initial auto-connect failed or the
           server was briefly unreachable, since _create_widget() only
           runs once per app session (QWidget is cached after first
           creation) and there'd otherwise be no way to retry without
           restarting. Color/tooltip set at runtime in
           ReportingModule._on_connect_result(). -->
      <widget class="QPushButton" name="db_status_indicator">
       <property name="toolTip">
        <string>Database: not connected yet</string>
       </property>
       <property name="text">
        <string/>
       </property>
       <property name="flat">
        <bool>true</bool>
       </property>
       <property name="cursor">
        <cursorShape>PointingHandCursor</cursorShape>
       </property>
       <property name="minimumSize">
        <size>
         <width>14</width>
         <height>14</height>
        </size>
       </property>
       <property name="maximumSize">
        <size>
         <width>14</width>
         <height>14</height>
        </size>
       </property>
       <property name="styleSheet">
        <string notr="true">QPushButton { background-color: #999; border-radius: 7px; border: none; }</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
