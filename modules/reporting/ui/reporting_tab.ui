      <item>
       <layout class="QHBoxLayout" name="reportTypeLayout">
        <item>
         <widget class="QLabel" name="reportTypeLabel">
          <property name="text">
           <string>Report Type:</string>
          </property>
         </widget>
        </item>
        <item>
         <!-- Items populated at runtime from modules.reporting.reports.REPORT_TYPES
              (ReportingModule._create_widget), not listed here. Adding a
              report type means adding a file under modules/reporting/reports/,
              never editing this .ui file. -->
         <widget class="QComboBox" name="report_type_combo">
         </widget>
        </item>
        <item>
         <spacer name="reportTypeSpacer">
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>40</width>
            <height>20</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </item>
      <item>
       <!-- Customer and Employee share row 0 (no report type uses both at
            once, see modules/reporting/reports/*.py's ReportDefinition
            flags), same pairing as Start/End Date on row 1, so every row
            in this grid fills all 4 columns instead of leaving the right
            half empty on rows that used to hold just one filter. Department
            (row 2) has no second filter to pair with yet, so columns 2-3
            are left empty there rather than forcing an unrelated pairing. -->
       <layout class="QGridLayout" name="filterLayout">
        <item row="0" column="0">
         <widget class="QLabel" name="customerLabel">
          <property name="text">
           <string>Customer:</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QPushButton" name="customer_filter_btn">
          <property name="text">
           <string>Customers: All</string>
          </property>
         </widget>
        </item>
        <item row="0" column="2">
         <widget class="QLabel" name="employeeLabel">
          <property name="text">
           <string>Employee:</string>
          </property>
         </widget>
        </item>
        <item row="0" column="3">
         <widget class="QPushButton" name="employee_filter_btn">
          <property name="text">
           <string>Employees: All</string>
          </property>
         </widget>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="startDateLabel">
          <property name="text">
           <string>Start Date:</string>
          </property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="QDateEdit" name="report_start_date">
          <property name="calendarPopup">
           <bool>true</bool>
          </property>
          <property name="displayFormat">
           <string>yyyy-MM-dd</string>
          </property>
          <property name="specialValueText">
           <string>(No Filter)</string>
          </property>
          <property name="minimumDate">
           <date>
            <year>2000</year>
            <month>1</month>
            <day>1</day>
           </date>
          </property>
          <property name="date">
           <date>
            <year>2000</year>
            <month>1</month>
            <day>1</day>
           </date>
          </property>
         </widget>
        </item>
        <item row="1" column="2">
         <widget class="QLabel" name="endDateLabel">
          <property name="text">
           <string>End Date:</string>
          </property>
         </widget>
        </item>
        <item row="1" column="3">
         <widget class="QDateEdit" name="report_end_date">
          <property name="calendarPopup">
           <bool>true</bool>
          </property>
          <property name="displayFormat">
           <string>yyyy-MM-dd</string>
          </property>
          <property name="specialValueText">
           <string>(No Filter)</string>
          </property>
          <property name="minimumDate">
           <date>
            <year>2000</year>
            <month>1</month>
            <day>1</day>
           </date>
          </property>
          <property name="date">
           <date>
            <year>2000</year>
            <month>1</month>
            <day>1</day>
           </date>
          </property>
         </widget>
        </item>
        <item row="2" column="0">
         <widget class="QLabel" name="departmentLabel">
          <property name="text">
           <string>Department:</string>
          </property>
         </widget>
        </item>
        <item row="2" column="1">
         <widget class="QPushButton" name="department_filter_btn">
          <property name="text">
           <string>Departments: All</string>
          </property>
         </widget>
        </item>
        <item row="3" column="0" colspan="4">
         <widget class="QCheckBox" name="exclude_assemblies_check">
          <property name="text">
           <string>Exclude assembly sub-jobs</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
